# Configuración global para entorno de desarrollo
# Variables compartidas entre todos los servicios

REM_ENVIRONMENT=development
REM_POSTGRES_HOST=localhost
REM_POSTGRES_PORT=5432
REM_POSTGRES_USER=user
REM_POSTGRES_PASSWORD=supersecreta
REM_POSTGRES_DB=rem_development
REM_POSTGRES_SSLMODE=disable

# Driver de base de datos
REM_DB_DRIVER=postgres

# Logger configuration
REM_LOGGER_LEVEL=debug

# API Key para desarrollo (no secreta)
REM_API_KEY=supersecret-api-key-for-dev

# Puertos HTTP por servicio (desarrollo) - ÚNICOS
REM_AUTH_HTTP_PORT=4002
REM_ADDRESS_HTTP_PORT=4000
REM_PERSON_HTTP_PORT=4001

# Puertos gRPC por servicio (desarrollo) - ÚNICOS
REM_AUTH_GRPC_HOST=0.0.0.0
REM_AUTH_GRPC_PORT=50051
REM_ADDRESS_GRPC_HOST=0.0.0.0
REM_ADDRESS_GRPC_PORT=50052
REM_PERSON_GRPC_HOST=0.0.0.0
REM_PERSON_GRPC_PORT=50053

# Configuración para comunicación entre servicios (cliente)
REM_ADDRESS_HOST=localhost
REM_ADDRESS_PORT=50052
REM_PERSON_HOST=localhost
REM_PERSON_PORT=50053
