# Property Service - Production Environment
REM_SERVICE_NAME=property
REM_ENVIRONMENT=production

# API Configuration
REM_API_KEY=${PROPERTY_API_KEY}
REM_PROPERTY_HTTP_PORT=4004

# gRPC Configuration (for future use)
REM_GRPC_HOST=0.0.0.0
REM_GRPC_PORT=50054

# Database
REM_POSTGRES_HOST=${POSTGRES_HOST}
REM_POSTGRES_PORT=${POSTGRES_PORT}
REM_POSTGRES_USER=${POSTGRES_USER}
REM_POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
REM_POSTGRES_DB=${POSTGRES_DB}
REM_POSTGRES_SSLMODE=require

# Logger configuration
REM_LOGGER_LEVEL=info
