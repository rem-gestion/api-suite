	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global pre-request script",
					"// Add timestamp for debugging",
					"pm.globals.set('timestamp', new Date().toISOString());",
					"",
					"// Get current request info",
					"const currentUrl = pm.request.url.toString();",
					"const method = pm.request.method;",
					"",
					"// Auto-add API Key header for services that need it",
					"const needsApiKey = [",
					"    '/api/persons',",
					"    '/api/addresses',",
					"    '/api/contacts',",
					"    '/api/health/address'",
					"];",
					"",
					"const needsAuth = needsApiKey.some(path => currentUrl.includes(path));",
					"",
					"if (needsAuth) {",
					"    const apiKey = pm.environment.get('api_key');",
					"    if (apiKey) {",
					"        pm.request.headers.add({",
					"            key: 'X-Api-Key',",
					"            value: apiKey",
					"        });",
					"        console.log('✅ Added API Key header');",
					"    } else {",
					"        console.warn('⚠️ API Key required but not found in environment');",
					"    }",
					"}",
					"",
					"// Auto-add JWT token for authenticated endpoints",
					"const needsJWT = [",
					"    '/api/auth/me',",
					"    '/api/auth/logout',",
					"    '/api/users'",
					"];",
					"",
					"const needsToken = needsJWT.some(path => currentUrl.includes(path));",
					"",
					"if (needsToken) {",
					"    const accessToken = pm.environment.get('access_token');",
					"    if (accessToken) {",
					"        pm.request.headers.add({",
					"            key: 'Authorization',",
					"            value: `Bearer ${accessToken}`",
					"        });",
					"        console.log('✅ Added JWT Authorization header');",
					"    } else {",
					"        console.warn('⚠️ JWT token required but not found in environment. Run login first.');",
					"    }",
					"}",
					"",
					"// Auto-populate request body with environment variables for specific endpoints",
					"if (method === 'POST' || method === 'PUT') {",
					"    try {",
					"        let body = pm.request.body;",
					"        if (body && body.mode === 'raw') {",
					"            let bodyString = body.raw;",
					"            ",
					"            // Replace placeholders with environment variables",
					"            bodyString = bodyString.replace(/{{person_id}}/g, pm.environment.get('person_id') || '');",
					"            bodyString = bodyString.replace(/{{address_id}}/g, pm.environment.get('address_id') || '');",
					"            bodyString = bodyString.replace(/{{contact_id}}/g, pm.environment.get('contact_id') || '');",
					"            bodyString = bodyString.replace(/{{test_email}}/g, pm.environment.get('test_email') || '');",
					"            bodyString = bodyString.replace(/{{test_password}}/g, pm.environment.get('test_password') || '');",
					"            bodyString = bodyString.replace(/{{test_dni}}/g, pm.environment.get('test_dni') || '');",
					"            bodyString = bodyString.replace(/{{test_phone}}/g, pm.environment.get('test_phone') || '');",
					"            bodyString = bodyString.replace(/{{test_personal_email}}/g, pm.environment.get('test_personal_email') || '');",
					"            ",
					"            // Update the request body",
					"            pm.request.body.raw = bodyString;",
					"        }",
					"    } catch (e) {",
					"        console.log('Body replacement skipped:', e.message);",
					"    }",
					"}",
					"",
					"// Log request details for debugging",
					"console.log(`🚀 ${method} ${currentUrl}`);",
					"if (needsAuth) console.log('🔑 API Key: Required');",
					"if (needsToken) console.log('🎫 JWT Token: Required');"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test script",
					"// Log basic response info",
					"console.log(`${pm.info.requestName}: ${pm.response.status} ${pm.response.code}`);",
					"",
					"// Auto-save important IDs from responses",
					"if (pm.response.code === 200 || pm.response.code === 201) {",
					"    try {",
					"        const response = pm.response.json();",
					"        const currentUrl = pm.request.url.toString();",
					"        ",
					"        // Save login tokens from auth endpoints",
					"        if (currentUrl.includes('/api/auth/login') && response.access_token) {",
					"            pm.environment.set('access_token', response.access_token);",
					"            pm.environment.set('refresh_token', response.refresh_token || '');",
					"            console.log('🎫 Saved JWT tokens from login');",
					"        }",
					"        ",
					"        // Save user info from auth endpoints",
					"        if (currentUrl.includes('/api/auth/me') && response.id) {",
					"            pm.environment.set('user_id', response.id);",
					"            pm.environment.set('person_id', response.person_id || '');",
					"            console.log('👤 Saved user info from /me endpoint');",
					"        }",
					"        ",
					"        // Save person ID if creating/getting person",
					"        if (response.id && currentUrl.includes('/api/persons')) {",
					"            pm.environment.set('person_id', response.id);",
					"            console.log('👤 Saved person_id:', response.id);",
					"            ",
					"            // If it's a person with address, save address ID too",
					"            if (response.address_id) {",
					"                pm.environment.set('address_id', response.address_id);",
					"                console.log('🏠 Saved address_id from person:', response.address_id);",
					"            }",
					"        }",
					"        ",
					"        // Save address ID if creating/getting address",
					"        if (response.id && currentUrl.includes('/api/addresses')) {",
					"            pm.environment.set('address_id', response.id);",
					"            console.log('🏠 Saved address_id:', response.id);",
					"        }",
					"        ",
					"        // Save contact ID if creating/getting contact",
					"        if (response.id && currentUrl.includes('/api/contacts')) {",
					"            pm.environment.set('contact_id', response.id);",
					"            console.log('📞 Saved contact_id:', response.id);",
					"        }",
					"        ",
					"        // Save first ID from list responses",
					"        if (Array.isArray(response) && response.length > 0 && response[0].id) {",
					"            if (currentUrl.includes('/api/persons')) {",
					"                pm.environment.set('person_id', response[0].id);",
					"                console.log('👤 Saved first person_id from list:', response[0].id);",
					"            }",
					"            if (currentUrl.includes('/api/addresses')) {",
					"                pm.environment.set('address_id', response[0].id);",
					"                console.log('🏠 Saved first address_id from list:', response[0].id);",
					"            }",
					"            if (currentUrl.includes('/api/contacts')) {",
					"                pm.environment.set('contact_id', response[0].id);",
					"                console.log('📞 Saved first contact_id from list:', response[0].id);",
					"            }",
					"        }",
					"        ",
					"        // Save other useful data based on endpoint",
					"        if (currentUrl.includes('/api/persons') && response.individual) {",
					"            if (response.individual.dni) {",
					"                console.log('📋 Person DNI:', response.individual.dni);",
					"            }",
					"        }",
					"        ",
					"    } catch (e) {",
					"        // Response is not JSON, skip auto-save",
					"        console.log('ℹ️ Non-JSON response, skipping auto-save');",
					"    }",
					"} else {",
					"    console.log('❌ Request failed with status:', pm.response.code);",
					"    ",
					"    // Log error details if available",
					"    try {",
					"        const errorResponse = pm.response.json();",
					"        if (errorResponse.error) {",
					"            console.log('Error details:', errorResponse.error);",
					"        }",
					"    } catch (e) {",
					"        console.log('Error response body:', pm.response.text());",
					"    }",
					"}"
				]
			}
		}
	],
