{
	"info": {
		"_postman_id": "rem-api-collection",
		"name": "REM Real Estate Management API",
		"description": "Complete collection for testing REM microservices through API Gateway\n\n**Base URL**: {{base_url}} (http://localhost:8081)\n\n**Services**:\n- Auth & Identity Service: Authentication, users, profiles\n- Person Service: Individuals, companies, contacts\n- Address Service: Property addresses\n\n**Test Users** (from seed data):\n- juan.perez@example.com / password\n- maria.gonzalez@example.com / password\n- admin@acmecorp.com / password (company)\n\n**Usage**:\n1. Run authentication requests to get tokens\n2. Use {{access_token}} in subsequent requests\n3. Test CRUD operations on persons, addresses, and contacts",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "🔐 Authentication & Users",
			"description": "Authentication, user management, and profile operations",
			"item": [
				{
					"name": "📝 Register New User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('registered_user_id', response.user_id);",
									"    if (response.person_id) {",
									"        pm.environment.set('registered_person_id', response.person_id);",
									"    }",
									"    console.log('Registration successful. User ID:', response.user_id);",
									"    if (response.person_id) {",
									"        console.log('Person ID:', response.person_id);",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test.user.{{$timestamp}}@example.com\",\n  \"password\": \"password123\",\n  \"person\": {\n    \"type\": \"individual\",\n    \"individual\": {\n      \"first_name\": \"Test\",\n      \"last_name\": \"User\",\n      \"dni\": \"12345678\",\n      \"sexo\": \"masculino\"\n    },\n    \"address\": {\n      \"street\": \"Test Street\",\n      \"number\": 123,\n      \"city\": \"Test City\",\n      \"state\": \"Test State\",\n      \"zip\": \"1234\",\n      \"country\": \"AR\"\n    }\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						},
						"description": "Register a new user with optional person data. Creates both user account and associated person record via microservices communication.\n\nPayload structure:\n- email: User email (required)\n- password: User password (required) \n- person: Person data (optional)\n  - type: 'individual' or 'company'\n  - individual: Individual person data (when type=individual)\n    - first_name, last_name, dni, sexo\n  - address: Address data (optional)\n    - street, number, city, state, zip, country\n\nResponse includes user_id and person_id for successful registrations."
					},
					"response": []
				},
				{
					"name": "🔑 Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('access_token', response.access_token);",
									"    pm.environment.set('refresh_token', response.refresh_token);",
									"    pm.environment.set('user_id', response.user_id);",
									"    if (response.user.person_id) {",
									"        pm.environment.set('person_id', response.person_id);",
									"    }",
									"    console.log('Tokens saved to environment');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"juan.perez@example.com\",\n  \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Login with email and password. Auto-saves tokens to environment."
					},
					"response": []
				},
				{
					"name": "🔄 Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('access_token', response.access_token);",
									"    pm.environment.set('refresh_token', response.refresh_token);",
									"    console.log('Tokens refreshed');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/refresh",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "refresh"]
						},
						"description": "Refresh access token using refresh token"
					},
					"response": []
				},
