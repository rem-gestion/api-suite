# Auth Identity Service - Production Environment Template
# Copia este archivo a .env.production y rellena con valores reales

REM_SERVICE_NAME=auth-identity
REM_ENVIRONMENT=production

# API Configuration - CAMBIAR EN PRODUCCIÓN
REM_API_KEY=your-secure-api-key-here
REM_AUTH_HTTP_PORT=3000

# gRPC Configuration
REM_GRPC_HOST=0.0.0.0
REM_GRPC_PORT=50051

# Database - CONFIGURAR PARA PRODUCCIÓN
REM_POSTGRES_HOST=your-production-db-host
REM_POSTGRES_PORT=5432
REM_POSTGRES_USER=your-production-db-user
REM_POSTGRES_PASSWORD=your-secure-db-password
REM_POSTGRES_DB=auth_production
REM_POSTGRES_SSLMODE=require

# Logger
REM_LOGGER_LEVEL=info

# JWT Configuration - CAMBIAR EN PRODUCCIÓN
REM_JWT_SECRET=your-very-secure-jwt-secret-here
