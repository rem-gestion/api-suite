# Auth Identity Service - Development Environment
REM_SERVICE_NAME=auth
REM_ENVIRONMENT=development

# API Configuration
REM_API_KEY=supersecret-api-key-for-dev
REM_AUTH_HTTP_PORT=4002

# gRPC Configuration  
REM_GRPC_HOST=0.0.0.0
