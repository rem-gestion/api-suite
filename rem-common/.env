# necesitamos un host por cada db para cada servicio
REM_POSTGRES_HOST=...
REM_POSTGRES_PORT=5432

#configuracion de rabbit en docker
REM_RABBIT_HOST=rabbitmq
REM_RABBIT_PORT=5672
REM_RABBIT_USER=user
REM_RABBIT_PASSWORD=password

# configuracion de redis en docker
REM_REDIS_ADDR=redis:6379
REM_REDIS_ENABLED=true
REM_LOGGER_LEVEL=debug
REM_SERVER_PORT=4000